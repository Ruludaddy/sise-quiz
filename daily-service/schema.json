{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DailyQuestion",
  "description": "얼마일까? '오늘의 문제' 데이터 계약. 배치가 매일 생성해 정적 JSON으로 게시하고, 미니앱 클라이언트가 fetch 해요.",
  "type": "object",
  "required": ["date", "question", "answer"],
  "additionalProperties": false,
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "KST 기준 날짜 (YYYY-MM-DD). 클라이언트의 서버시간 날짜키와 일치해야 해요."
    },
    "question": { "type": "string", "minLength": 1, "description": "문제 문구" },
    "answer": { "type": "number", "exclusiveMinimum": 0, "description": "정답(가격, 원)" },
    "unit": { "type": "string", "description": "단위 표시(기본 '원')" },
    "min": { "type": "number", "description": "입력 참고 하한(생략 시 answer*0.2)" },
    "max": { "type": "number", "description": "입력 참고 상한(생략 시 answer*3)" },
    "source": { "type": "string", "description": "출처 표기 (예: 'KAMIS 농산물유통정보(aT)')" },
    "sourceUrl": { "type": "string", "description": "출처 링크" },
    "note": { "type": "string", "description": "문제 아래 보조 설명" }
  }
}
